<style>
  .karrusel {
  width: 100%;
  overflow: hidden;
  background-color: #ffffff;
}

.karrusel-container {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  padding: 20px;
}

.karrusel-item {
  flex: 0 0 80%;
   max-width: 320px;
}

.tekstkarrusel{
  padding: 20px;
}

@media (min-width: 840px) {
  .karrusel-container {
    gap: 30px;
    padding: 20px 40px;
  }

  .karrusel-item {
    flex: 0 0 220px;
    max-width: 220px;
  }

.karrusel-item p {
  margin: 0 0 8px;
  font-size: 14px;
  line-height: 1.4;
}
}

</style>