---
import global from '../styles/global.css';
---

<section>
<h2>Vinderen</h2>

<div class="divimgtekst">
<div class="img">
      <img src="/img2/vinder.webp" alt="Instant foto af siv">
</div>
<div class="tekst">
<p>Stefan Grage <br><br>

Amager Fælled <br><br>Et lille snapshot fra Amager Fælled, en stor skov i den sydvestlige del af København, Danmark. Taget med et Lomomatic Square.
</p>
</div>
</div>
</section>

<style>
h2 {text-align: center;}
img {padding-left: 5%;}
.tekst {max-width: 75%;
padding-left: 20%;}

section {padding:50px ;
background-color: #D2D4E2;}


 @media (min-width: 1024px) {
    .divimgtekst {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-top: 20px;
    }
    img {padding-left: 50%;
    min-width: 100%;}
    .tekst {max-width: 100%;
padding-right: 50%;}
  }
</style>
