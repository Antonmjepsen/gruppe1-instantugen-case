---
const { text = "Klik her" } = Astro.props;
---

<a class="button">
  {text}
</a>

<style>
  .button {
    display: inline-block;
    padding: 10px 20px;
    margin: 50px;
    border: 2px solid black;
    text-decoration: none;
    color: black;
    font-weight: 600;
   background-color: white;
   border-radius: 2px;

  }

  .button:hover {
  background-color: #D2D4E2;
  cursor: pointer;
  transform: scale(1.05);
}
</style>